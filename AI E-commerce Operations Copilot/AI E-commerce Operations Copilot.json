    {
      "parameters": {
        "jsCode": "const totalOrders = Number($json.total_orders);\nconst totalRevenue = Number($json.total_revenue);\nconst pendingOrders = Number($json.pending_orders);\nconst lowStockProducts = Number($json.low_stock_products);\nconst customerComplaints = Number($json.customer_complaints);\nconst pendingReturns = Number($json.pending_returns);\nconst averageOrderValue = Number($json.average_order_value);\nconst customerSatisfaction = Number($json.customer_satisfaction);\n\nconst pendingOrderRate =\n  (pendingOrders / totalOrders) * 100;\n\nconst complaintRate =\n  (customerComplaints / totalOrders) * 100;\n\nconst returnRate =\n  (pendingReturns / totalOrders) * 100;\n\nlet operationalStatus;\n\nif (\n  pendingOrderRate > 10 ||\n  lowStockProducts >= 5 ||\n  complaintRate > 3 ||\n  returnRate > 5 ||\n  customerSatisfaction < 4\n) {\n  operationalStatus = \"Needs Attention\";\n} else {\n  operationalStatus = \"Healthy\";\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      pending_order_rate: Number(pendingOrderRate.toFixed(2)),\n      complaint_rate: Number(complaintRate.toFixed(2)),\n      return_rate: Number(returnRate.toFixed(2)),\n      operational_status: operationalStatus\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -32
      ],
      "id": "087ed6de-20d1-46b0-bc47-491001984345",
      "name": "Operations Metrics Calculator"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the e-commerce operations data below.\n\nOrders: {{ $json.total_orders }}\nRevenue: {{ $json.total_revenue }}\nPending Orders: {{ $json.pending_orders }}\nPending Order Rate: {{ $json.pending_order_rate }}%\nLow Stock Products: {{ $json.low_stock_products }}\nCustomer Complaints: {{ $json.customer_complaints }}\nPending Returns: {{ $json.pending_returns }}\nReturn Rate: {{ $json.return_rate }}%\nCustomer Satisfaction: {{ $json.customer_satisfaction }}\nTop Product: {{ $json.top_product }}\n\nIdentify the main operational problem and recommend two actions.\n\nKeep all responses concise.",
