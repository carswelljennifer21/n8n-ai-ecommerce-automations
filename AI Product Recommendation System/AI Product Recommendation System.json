    {
      "parameters": {
        "jsCode": "const output = $json.text;\n\nlet result;\n\ntry {\n  result = JSON.parse(output);\n} catch (error) {\n  const cleaned = output\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  result = JSON.parse(cleaned);\n}\n\nreturn [\n  {\n    json: result\n  }\n];"
      },
