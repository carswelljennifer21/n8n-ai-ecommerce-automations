    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const stock = Number(item.json[\"Current Stock\"]);\n  const weeklySales = Number(item.json[\"Weekly Sales\"]);\n  const leadTime = Number(item.json[\"Lead Time\"]);\n\n  const weeksRemaining = weeklySales > 0\n    ? stock / weeklySales\n    : 0;\n\n  let stockRisk;\n\n  if (weeksRemaining < leadTime) {\n    stockRisk = \"High\";\n  } else if (weeksRemaining < leadTime + 2) {\n    stockRisk = \"Medium\";\n  } else {\n    stockRisk = \"Low\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      \"Weeks Remaining\": Number(weeksRemaining.toFixed(2)),\n      \"Stock Risk\": stockRisk\n    }\n  };\n});"
      },
