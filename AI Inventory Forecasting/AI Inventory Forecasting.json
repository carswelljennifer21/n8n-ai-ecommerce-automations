    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const text = String(item.json.output || \"\")\n    .replace(/\\\\n/g, \"\\n\");\n\n  const blocks = text.split(/(?=Product:\\s*)/i);\n\n  for (const block of blocks) {\n    if (!block.trim()) continue;\n\n    const product = block.match(/Product:\\s*([^\\n]+)/i)?.[1]?.trim();\n    const weeks = block.match(/Weeks Remaining:\\s*([0-9]+(?:\\.[0-9]+)?)/i)?.[1];\n    const risk = block.match(/Stock Risk:\\s*([^\\n]+)/i)?.[1]?.trim();\n    const action = block.match(/Recommended Action:\\s*([^\\n]+)/i)?.[1]?.trim();\n\n    if (product) {\n      results.push({\n        json: {\n          Product: product,\n          \"Weeks Remaining\": Number(weeks),\n          \"Stock Risk\": risk,\n          \"Recommended Action\": action\n        }\n      });\n    }\n  }\n}\n\nreturn results;"
      },
